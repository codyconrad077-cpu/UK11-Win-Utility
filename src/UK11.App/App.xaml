   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Switch" TargetType="ToggleButton"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="21"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Pill" Background="#333943" CornerRadius="11"/><Ellipse x:Name="Dot" Fill="#CCD3DE" Width="15" Height="15" HorizontalAlignment="Left" Margin="3,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="#1683FF"/><Setter TargetName="Dot" Property="Fill" Value="White"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Dot" Property="Stroke" Value="White"/><Setter TargetName="Dot" Property="StrokeThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
