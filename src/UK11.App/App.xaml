<Application x:Class="UK11.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#74B8FF"/><SolidColorBrush x:Key="Ink" Color="#F2F5FC"/><SolidColorBrush x:Key="Muted" Color="#8E9AAF"/><SolidColorBrush x:Key="Surface" Color="#111317"/><SolidColorBrush x:Key="Line" Color="#2B3038"/>
