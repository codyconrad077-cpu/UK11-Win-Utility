<Window x:Class="UK11.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UK11 ULTIMATE" Width="1180" Height="800" MinWidth="860" MinHeight="620" Background="#080E18" Foreground="White">
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,22,0">
   <TextBlock Text="ϟ UK11" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="U L T I M A T E" Margin="0,0,0,36" Foreground="#8BA7C2"/>
   <Button Content="Dashboard" Click="DashboardClick"/><Button Content="Optimisations" Click="TweaksClick"/><Button Content="Backups &amp; activity" Click="BackupsClick"/>
   <TextBlock Text="MILESTONE 01" Foreground="#37B9FF" Margin="0,34,0,8"/><TextBlock Text="Measured choices.&#10;Reversible changes.&#10;Your PC, your control." Foreground="#8BA7C2"/>
  </StackPanel>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="Heading" Text="System overview" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Windows 10 / 11 • Local operations • No performance promises" Foreground="#8BA7C2" Margin="0,8,0,22"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <StackPanel x:Name="DashboardPanel">
      <Border Background="#101D2C" CornerRadius="14" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="HARDWARE INTELLIGENCE" Foreground="{StaticResource Accent}"/><TextBlock x:Name="Inventory" Margin="0,16,0,0" FontSize="17"/></StackPanel></Border>
      <Border Background="#101D2C" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="LIVE MEMORY" Foreground="{StaticResource Accent}"/><TextBlock x:Name="MemoryText" FontSize="24" Margin="0,14,0,10"/><ProgressBar x:Name="MemoryBar" Height="10" Maximum="100" Foreground="{StaticResource Accent}"/><TextBlock x:Name="Uptime" Margin="0,16,0,0" Foreground="#8BA7C2"/></StackPanel></Border>
      <TextBlock Text="Start with a single change, test your usual workload, then keep or restore it. GPU sensors, FPS capture, driver installation and firmware modification are not included in this milestone." Margin="0,22,0,0" Foreground="#8BA7C2"/>
     </StackPanel>
     <StackPanel x:Name="TweaksPanel" Visibility="Collapsed"><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search by title, category or description"/><TextBlock Text="Search catalogue • inspect the preview before applying" Margin="0,8,0,16" Foreground="#8BA7C2"/><StackPanel x:Name="Cards"/></StackPanel>
     <StackPanel x:Name="BackupsPanel" Visibility="Collapsed"><Button Content="Refresh backups and log" Click="RefreshClick" HorizontalAlignment="Left"/><TextBlock Text="Restore each setting individually. Conflicting external changes are preserved. This is a registry-value backup, not a Windows restore point." Margin="0,12,0,16"/><StackPanel x:Name="BackupCards"/><TextBox x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></StackPanel>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="Status" Text="Ready • Changes require your confirmation" Foreground="{StaticResource Accent}" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</Window>
