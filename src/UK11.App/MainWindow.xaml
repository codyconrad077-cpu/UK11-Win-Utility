<Window x:Class="UK11.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="UK11 ULTIMATE — Control centre" Width="1440" Height="960" MinWidth="1140" MinHeight="740" WindowStyle="None" ResizeMode="CanResize" Background="#090E17" Foreground="#F2F5FC" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="#0C131F" BorderBrush="#202C3D" BorderThickness="0,0,1,0"><Grid Margin="20,24"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="#1F74DD" Margin="0,0,10,0"><Path Data="M 20,5 L 9,21 L 17,21 L 12,33 L 28,15 L 20,15 Z" Fill="White" Stretch="Uniform" Width="18" Height="24"/></Border><TextBlock Text="UK11" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="U L T I M A T E   /   0.2" Style="{StaticResource Caption}" Margin="46,5,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="14,0,0,12"/>
    <RadioButton x:Name="OverviewNav" GroupName="Page" Style="{StaticResource Navigation}" IsChecked="True" Click="DashboardClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/><TextBlock Text="Overview"/></StackPanel></RadioButton>
    <RadioButton x:Name="CatalogueNav" GroupName="Page" Style="{StaticResource Navigation}" Click="TweaksClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/><TextBlock Text="Optimisation library"/></StackPanel></RadioButton>
    <RadioButton x:Name="RecoveryNav" GroupName="Page" Style="{StaticResource Navigation}" Click="BackupsClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/><TextBlock Text="Recovery &amp; activity"/></StackPanel></RadioButton>
    <TextBlock Text="QUICK ACCESS" Style="{StaticResource Caption}" Margin="14,34,0,12"/>
    <Button Style="{StaticResource Quiet}" Content="☆   Favourites" HorizontalContentAlignment="Left" Click="FavoritesClick" Margin="0,2"/>
    <Button Style="{StaticResource Quiet}" Content="◈   Gaming &amp; capture" Tag="Gaming" Click="CategoryShortcut" Margin="0,2"/>
    <Button Style="{StaticResource Quiet}" Content="◉   Privacy preferences" Tag="Privacy" Click="CategoryShortcut" Margin="0,2"/>
    <Button Style="{StaticResource Quiet}" Content="ϟ   Power configuration" Tag="Power configuration" Click="CategoryShortcut" Margin="0,2"/>
    <Border BorderBrush="#253246" BorderThickness="0,1,0,0" Margin="12,26,12,18"/><TextBlock Text="Configuration is personal.&#10;Measure before calling it faster." Foreground="#728299" FontSize="11" Margin="14,0"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#121E2E" CornerRadius="10" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#57D1AD" Margin="0,0,7,0"/><TextBlock Text="LOCAL WORKSPACE" FontSize="10" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Your backups stay on this PC" Foreground="#8595AC" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1" Background="#0B111C"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="UK11   /   CONTROL CENTRE" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="28,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource Quiet}" Content="─" Width="46" Click="MinimizeClick" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource Quiet}" Content="□" Width="46" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore"/><Button Style="{StaticResource Quiet}" Content="✕" Width="46" Click="CloseClick" AutomationProperties.Name="Close"/></StackPanel></Grid>
  <Grid Grid.Column="1" Grid.Row="1" Margin="28,22,28,16"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="Heading" Text="Your system. In focus." FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="Subheading" Text="Live readings. Deliberate changes. Complete control." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Button Content="↻   Rescan system" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshClick" x:Name="RescanButton"/></Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
     <Border CornerRadius="18" Padding="28" BorderBrush="#2C496A" BorderThickness="1" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17365B" Offset="0"/><GradientStop Color="#111E33" Offset="0.75"/><GradientStop Color="#172C47" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BUILT AROUND YOUR WINDOWS" Foreground="#8DC9FF" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Less noise.&#10;More control." FontSize="36" FontWeight="SemiBold" Margin="0,10,0,12"/><TextBlock Text="Explore your configuration, understand every change, and keep a way back. Nothing is applied automatically." Foreground="#B1C1D7" MaxWidth="470" HorizontalAlignment="Left"/><WrapPanel Margin="0,22,0,0"><Button Style="{StaticResource Primary}" Content="Explore the library   →" Click="TweaksClick" Margin="0,0,10,0"/><Button Content="View backups" Click="BackupsClick"/></WrapPanel></StackPanel><Border Grid.Column="1" Background="#182F4C" CornerRadius="14" BorderBrush="#335779" BorderThickness="1" Padding="22" Margin="24,0,0,0" VerticalAlignment="Center"><StackPanel><TextBlock Text="YOUR CATALOGUE" Foreground="#95B6D8" FontSize="10"/><TextBlock x:Name="CatalogueTotal" Text="Scanning…" FontSize="43" FontWeight="Light" Margin="0,12,0,4"/><TextBlock Text="discovered setting targets" Foreground="#ACBFD6"/><TextBlock x:Name="CatalogueBreakdown" Foreground="#7FA0C6" FontSize="11" Margin="0,18,0,0"/></StackPanel></Border></Grid></Border>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}"><StackPanel><Grid><TextBlock Text="PROCESSOR LOAD" Style="{StaticResource Caption}"/><TextBlock Text="LIVE / 2s" Foreground="#68D8B5" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="CpuText" Text="Sampling…" FontSize="32" FontWeight="Light" Margin="0,10,0,0"/><Canvas x:Name="CpuCanvas" Height="66" Margin="0,12,0,0" ClipToBounds="True"><Polyline x:Name="CpuLine" Stroke="#74B8FF" StrokeThickness="2" StrokeLineJoin="Round"/></Canvas><TextBlock Text="System-wide CPU use · 60-sample history" Foreground="#73869F" FontSize="11"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><Grid><TextBlock Text="PHYSICAL MEMORY" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryPercent" Text="—" Foreground="#BCA3FF" HorizontalAlignment="Right" FontSize="12"/></Grid><TextBlock x:Name="MemoryText" Text="Sampling…" FontSize="30" FontWeight="Light" Margin="0,10,0,0"/><Canvas x:Name="MemoryCanvas" Height="66" Margin="0,12,0,0" ClipToBounds="True"><Polyline x:Name="MemoryLine" Stroke="#BCA3FF" StrokeThickness="2" StrokeLineJoin="Round"/></Canvas><TextBlock x:Name="Uptime" Text="Waiting for system readings" Foreground="#73869F" FontSize="11"/></StackPanel></Border>
     </Grid>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="AVAILABLE PREFERENCES" Style="{StaticResource Caption}"/><TextBlock x:Name="AvailableCount" Text="—" FontSize="26" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="SAVED ORIGINALS" Style="{StaticResource Caption}"/><TextBlock x:Name="BackupCount" Text="—" FontSize="26" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="ACTIVE POWER PLAN" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanName" Text="Detecting…" FontSize="18" Margin="0,12,0,0"/></StackPanel></Border></Grid>
     <Border Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HARDWARE IDENTITY" Style="{StaticResource Caption}"/><TextBlock Text="PROCESSOR" Style="{StaticResource Caption}" Margin="0,22,0,5"/><TextBlock x:Name="CpuName" Text="Detecting…" FontSize="15"/><TextBlock x:Name="ThreadText" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="OPERATING SYSTEM" Style="{StaticResource Caption}" Margin="0,20,0,5"/><TextBlock x:Name="OsName"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PLATFORM" Style="{StaticResource Caption}"/><TextBlock Text="MOTHERBOARD" Style="{StaticResource Caption}" Margin="0,22,0,5"/><TextBlock x:Name="BoardName" Text="Detecting…" FontSize="15"/><TextBlock Text="FIRMWARE VERSION" Style="{StaticResource Caption}" Margin="0,20,0,5"/><TextBlock x:Name="FirmwareName" Text="Detecting…"/><TextBlock Text="Read-only inventory. Missing sensor data is not estimated." Foreground="#73869F" FontSize="11" Margin="0,16,0,0"/></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="TweaksPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="326"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Search catalogue"/><TextBlock Text="Search settings, descriptions, or groups…" Foreground="#697F9C" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="Categories" Grid.Column="2" SelectionChanged="FilterChanged" AutomationProperties.Name="Category filter"/></Grid>
      <Grid Grid.Row="1" Margin="0,8,0,6"><TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><ComboBox x:Name="States" Width="150" HorizontalAlignment="Right" SelectionChanged="FilterChanged" AutomationProperties.Name="State filter"/></Grid>
      <ListBox Grid.Row="2" x:Name="TweakList" SelectionChanged="TweakSelectionChanged" AutomationProperties.Name="Setting catalogue"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Checked="SelectionChecked" Unchecked="SelectionChecked" AutomationProperties.Name="Select for batch review"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding CategoryLabel}" Foreground="#7B91AD" FontSize="11" Margin="0,5,0,8"/><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="10"/></StackPanel></StackPanel><Button Grid.Column="2" Content="{Binding Star}" Style="{StaticResource Quiet}" Padding="2" VerticalAlignment="Top" Tag="{Binding}" Click="StarClick" AutomationProperties.Name="Toggle favourite"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="SelectionCount" Text="No preferences selected" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="ReviewButton" Content="Review selected   →" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="ReviewClick" IsEnabled="False"/></Grid>
     </Grid>
     <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SETTING DETAILS" Style="{StaticResource Caption}"/><TextBlock x:Name="DetailTitle" Text="Select a setting" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock x:Name="DetailCategory" Foreground="{StaticResource Accent}" FontSize="11"/><Border Background="#0C1522" CornerRadius="10" Padding="14" Margin="0,20,0,14"><StackPanel><TextBlock Text="CURRENT VALUE" Style="{StaticResource Caption}"/><TextBlock x:Name="DetailCurrent" Text="—" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="DetailEffect" Foreground="#A8B7CC" FontSize="12"/><Border BorderBrush="#29384D" BorderThickness="0,1,0,0" Margin="0,18,0,16"/><TextBlock Text="TARGET CONFIGURATION" Style="{StaticResource Caption}"/><TextBlock x:Name="TargetLabel" Margin="0,10,0,6"/><ComboBox x:Name="TargetChoices" DisplayMemberPath="Label" Visibility="Collapsed" Margin="0,6,0,4" AutomationProperties.Name="Power setting target option"/><TextBox x:Name="TargetNumber" Visibility="Collapsed" Margin="0,6,0,4" AutomationProperties.Name="Power setting target number"/><TextBlock x:Name="RangeText" Foreground="#7F93AD" FontSize="11" Margin="0,6,0,12"/><Button x:Name="ApplyButton" Content="Preview change" Style="{StaticResource Primary}" Click="ApplyDetailClick" IsEnabled="False"/><Button x:Name="RestoreButton" Content="Restore original" Margin="0,8,0,0" Click="RestoreDetailClick" IsEnabled="False"/><TextBlock x:Name="DetailRisk" Foreground="#D6B786" FontSize="11" Margin="0,18,0,8"/><TextBlock x:Name="DetailEvidence" Foreground="#7E93AE" FontSize="11"/><TextBlock x:Name="DetailRestart" Foreground="#7E93AE" FontSize="11" Margin="0,10,0,0"/><Expander Header="Technical implementation" Foreground="#A4B9D2" Margin="0,20,0,8"><StackPanel><TextBlock x:Name="DetailPath" Foreground="#7F93AD" FontSize="10" Margin="0,12,0,8"/><Button Content="Copy implementation" Click="CopyClick"/></StackPanel></Expander><Button Content="Windows reference  ↗" Style="{StaticResource Quiet}" Click="SourceClick"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid x:Name="BackupsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,0,18"><Grid><StackPanel Margin="0,0,180,0"><TextBlock Text="An original for every change." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Restore exact values. External conflicts are preserved. These are setting backups, not Windows restore points." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button Content="Review full restore" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RestoreAllClick"/></Grid></Border><ListBox x:Name="BackupList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding BackupLabel}" Foreground="#91A7C1" FontSize="11" Margin="0,7,12,0"/></StackPanel><Button Grid.Column="1" Content="Restore original" Tag="{Binding}" Click="RestoreRowClick" IsEnabled="{Binding CanRestore}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="TRANSACTION ACTIVITY" Style="{StaticResource Caption}" Margin="0,0,0,10"/><TextBox x:Name="Activity" IsReadOnly="True" Height="112" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Transaction activity"/></StackPanel></Border></Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#57D1AD" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="Ready · No changes applied automatically" Foreground="#8EA2BC" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="760"/></StackPanel><TextBlock Grid.Column="1" Text="LOCAL FIRST   /   PREVIEW 0.2" Foreground="#566F8E" FontSize="9" VerticalAlignment="Center"/></Grid>
  </Grid>
 </Grid>
</Window>
