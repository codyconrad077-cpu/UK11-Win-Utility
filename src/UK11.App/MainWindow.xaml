<Window x:Class="UK11.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UK11.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Apex Tweaks — made by riley" Width="1380" Height="900" MinWidth="980" MinHeight="720" WindowStyle="None" Background="#191A1D" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="ToggleRow"><Border Background="#111317" BorderBrush="#272C34" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4" MinHeight="60" ToolTip="{Binding Hint}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/><ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsOn,Mode=OneWay}" IsEnabled="{Binding Enabled}" Tag="{Binding}" Click="ToggleClick" AutomationProperties.Name="{Binding Name}"/></Grid></Border></DataTemplate>
 </Window.Resources>
 <Grid Background="#191A1D"><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="#0B0D10" BorderBrush="#303238" BorderThickness="0,0,1,0"><Grid Margin="12,18"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal" Margin="5,0"><Path Data="M 0,29 L 16,0 L 32,29 M 8,20 L 24,20" Stroke="#258AFF" StrokeThickness="3" Width="30" Height="30" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Apex Tweaks" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="made by riley" Foreground="#8797B0" FontSize="10" Margin="46,4,0,0"/></StackPanel>
   <StackPanel x:Name="Navigation" Grid.Row="1"><TextBlock Text="General" Foreground="#687480" FontSize="10" Margin="12,0,0,7"/>
    <RadioButton x:Name="HomeNav" GroupName="Pages" Tag="Home" Style="{StaticResource Navigation}" Content="⌂   Home" Click="NavigateClick" IsChecked="True"/>
    <RadioButton x:Name="RestoreNav" GroupName="Pages" Tag="System Restore" Style="{StaticResource Navigation}" Content="↶   System Restore" Click="NavigateClick"/>
    <RadioButton x:Name="DriversNav" GroupName="Pages" Tag="Drivers" Style="{StaticResource Navigation}" Content="◈   Drivers &amp; runtimes" Click="NavigateClick"/>
    <TextBlock Text="Tweaks" Foreground="#687480" FontSize="10" Margin="12,26,0,7"/>
    <RadioButton x:Name="GeneralNav" GroupName="Pages" Tag="General" Style="{StaticResource Navigation}" Content="⚙   General" Click="NavigateClick"/>
    <RadioButton x:Name="DebloatNav" GroupName="Pages" Tag="Debloating" Style="{StaticResource Navigation}" Content="♧   Debloating" Click="NavigateClick"/>
    <RadioButton x:Name="NetworkNav" GroupName="Pages" Tag="Networking" Style="{StaticResource Navigation}" Content="⌁   Networking" Click="NavigateClick"/>
    <RadioButton x:Name="AdvancedNav" GroupName="Pages" Tag="Advanced" Style="{StaticResource Navigation}" Content="⌘   Advanced" Click="NavigateClick"/>
    <RadioButton x:Name="ServicesNav" GroupName="Pages" Tag="Services" Style="{StaticResource Navigation}" Content="☷   Services" Click="NavigateClick"/>
    <RadioButton x:Name="BiosNav" GroupName="Pages" Tag="BIOS / SCEWIN" Style="{StaticResource Navigation}" Content="▣   BIOS / SCEWIN" Click="NavigateClick"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#111C2A" BorderBrush="#243A55" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="APEX / LOCAL" FontSize="11" FontWeight="SemiBold" Foreground="#78B9FF"/><TextBlock Text="Your changes. Your control." Foreground="#788BA3" FontSize="10" Margin="0,6,0,0"/><Button Content="About &amp; licenses" Style="{StaticResource Quiet}" Padding="0,4" FontSize="10" HorizontalAlignment="Left" Click="LicensesClick"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1" Background="#17181B"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Breadcrumb" Text="⌂   /   Home" Foreground="#7D858F" FontSize="11" VerticalAlignment="Center" Margin="22,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource Quiet}" Content="─" Width="42" Click="MinimizeClick"/><Button Style="{StaticResource Quiet}" Content="□" Width="42" Click="MaximizeClick"/><Button Style="{StaticResource Quiet}" Content="✕" Width="42" Click="CloseClick"/></StackPanel></Grid>
  <Grid Grid.Column="1" Grid.Row="1" Margin="20,18,20,12"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Grid><StackPanel Margin="0,0,300,0"><TextBlock x:Name="PageTitle" Text="Welcome to Apex Tweaks" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Performance, configuration and recovery — made simple." Foreground="#9097A3" FontSize="11" Margin="0,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top"><StackPanel x:Name="BulkButtons" Orientation="Horizontal" Visibility="Collapsed"><Button Content="Apply all tweaks" Style="{StaticResource Primary}" Click="ApplyAllClick" Margin="0,0,8,0"/><Button Content="Revert all tweaks" Click="RevertAllClick" ToolTip="Restore General and Advanced originals saved by Apex. Drivers, app removals, services and DNS have separate recovery workflows."/></StackPanel><Button x:Name="RefreshButton" Content="↻   Refresh" Click="RefreshClick"/></StackPanel></Grid>
   <Grid x:Name="ContentHost" Grid.Row="1">
    <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border CornerRadius="12" BorderBrush="#2A3A50" BorderThickness="1" Padding="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#101216" Offset="0.4"/><GradientStop Color="#11325B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▣" FontSize="25" Foreground="#6E849E"/><TextBlock x:Name="CpuUsage" Text="—" FontSize="28" Margin="0,14,0,2"/><TextBlock Text="CPU Usage" Foreground="#A9B4C5" FontSize="11"/></StackPanel><local:UsageGauge x:Name="CpuGauge" Grid.Column="1" Width="76" Height="76" VerticalAlignment="Center"/></Grid></Border>
      <Border Grid.Column="2" CornerRadius="12" BorderBrush="#2A3A50" BorderThickness="1" Padding="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#101216" Offset="0.4"/><GradientStop Color="#11325B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▤" FontSize="25" Foreground="#6E849E"/><TextBlock x:Name="GpuUsage" Text="—" FontSize="28" Margin="0,14,0,2"/><TextBlock Text="GPU Usage" Foreground="#A9B4C5" FontSize="11"/></StackPanel><local:UsageGauge x:Name="GpuGauge" Grid.Column="1" Width="76" Height="76" VerticalAlignment="Center"/></Grid></Border>
      <Border Grid.Column="4" CornerRadius="12" BorderBrush="#2A3A50" BorderThickness="1" Padding="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#101216" Offset="0.4"/><GradientStop Color="#11325B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▥" FontSize="25" Foreground="#6E849E"/><TextBlock x:Name="RamUsage" Text="—" FontSize="28" Margin="0,14,0,2"/><TextBlock Text="RAM Usage" Foreground="#A9B4C5" FontSize="11"/></StackPanel><local:UsageGauge x:Name="RamGauge" Grid.Column="1" Width="76" Height="76" VerticalAlignment="Center"/></Grid></Border>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Background="#0D0F13" CornerRadius="12" BorderBrush="#2C3037" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,0"><TextBlock Text="♨   Temperature Monitor" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><RadioButton x:Name="CpuTempTab" GroupName="Temp" IsChecked="True" Content="CPU" Style="{StaticResource Navigation}" Padding="12,6" Click="TempTabClick"/><RadioButton x:Name="GpuTempTab" GroupName="Temp" Content="GPU" Style="{StaticResource Navigation}" Padding="12,6" Click="TempTabClick"/></StackPanel></Grid><Grid Grid.Row="1" Margin="18,8"><local:TemperatureChart x:Name="TemperaturePlot" Height="272"/><Border Background="#172232" BorderBrush="#2E527A" BorderThickness="1" CornerRadius="7" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="TemperatureKind" Text="CPU" FontSize="9" Foreground="#86A4C6"/><TextBlock x:Name="TemperatureValue" Text="Unavailable" FontSize="18" Margin="0,4,0,0"/></StackPanel></Border></Grid><StackPanel Grid.Row="2" Margin="18,4,18,16"><TextBlock x:Name="SensorStatus" Text="Waiting for compatible sensor data…" Foreground="#7F8A9B" FontSize="10"/><Button Content="Sensor help / administrator access" Style="{StaticResource Quiet}" Padding="0,8,0,0" HorizontalAlignment="Left" FontSize="10" Click="SensorHelpClick"/></StackPanel></Grid></Border>
      <StackPanel Grid.Column="2"><Border Background="#0D0F13" CornerRadius="12" BorderBrush="#2C3037" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="System overview" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PROCESSOR" Style="{StaticResource Caption}" Margin="0,18,0,5"/><TextBlock x:Name="CpuName" Text="Detecting…" FontSize="12"/><TextBlock Text="GRAPHICS" Style="{StaticResource Caption}" Margin="0,16,0,5"/><TextBlock x:Name="GpuName" Text="Detecting…" FontSize="12"/><TextBlock x:Name="MemoryInfo" Foreground="#8C9DB4" FontSize="11" Margin="0,16,0,0"/><TextBlock x:Name="PlanName" Foreground="#8C9DB4" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#0D0F13" CornerRadius="12" BorderBrush="#2C3037" BorderThickness="1" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="System drive" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DiskInfo" Foreground="#8C9DB4" FontSize="11" Margin="0,14,0,10"/><ProgressBar x:Name="DiskBar" Maximum="100" Height="7" Foreground="#258AFF" Background="#22262E"/></StackPanel></Border></StackPanel>
     </Grid>
    </StackPanel></ScrollViewer>
    <Grid x:Name="TweaksPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="280" HorizontalAlignment="Left"><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search tweak names" AutomationProperties.Name="Search tweak names"/><TextBlock Text="Search tweaks…" Foreground="#718096" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="PowerSides" Visibility="Collapsed"><RadioButton x:Name="AcTab" GroupName="PowerSide" Content="Plugged in" Style="{StaticResource Navigation}" IsChecked="True" Padding="14,8" Click="PowerSideClick"/><RadioButton x:Name="DcTab" GroupName="PowerSide" Content="Battery" Style="{StaticResource Navigation}" Padding="14,8" Click="PowerSideClick"/></StackPanel></Grid><TextBlock x:Name="TweakCount" Grid.Row="1" Foreground="#7E8FA6" FontSize="11" VerticalAlignment="Center"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ToggleList" ItemTemplate="{StaticResource ToggleRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></Grid>
    <ScrollViewer x:Name="RestorePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Windows System Restore" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RestoreStatus" Foreground="#8F9CB0" Margin="0,12,0,18"/><WrapPanel><Button x:Name="CreateRestoreButton" Content="Create restore point" Style="{StaticResource Primary}" Click="CreateRestoreClick" Margin="0,0,10,8"/><Button Content="System Protection" Click="ProtectionClick" Margin="0,0,10,8"/><Button Content="Open Windows recovery" Click="WindowsRecoveryClick" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="RestorePoints" Foreground="#A7B6CB" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Apex tweak backups" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BackupSummary" Foreground="#8F9CB0" Margin="0,12,0,18"/><Button Content="Revert General &amp; Advanced tweaks" Click="RevertAllClick" HorizontalAlignment="Left"/><TextBlock Text="Driver packages, app removals, DNS and service changes have their own recovery controls. A setting backup is not a full Windows restore point." FontSize="11" Foreground="#7F8FA3" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="DriversPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel Margin="0,0,0,16"><RadioButton x:Name="NvidiaTab" GroupName="DriverVendor" Content="NVIDIA" Style="{StaticResource Navigation}" IsChecked="True" Click="DriverVendorClick"/><RadioButton x:Name="AmdTab" GroupName="DriverVendor" Content="AMD" Style="{StaticResource Navigation}" Click="DriverVendorClick"/><Button Content="Install recommended runtimes" Click="RuntimesClick" Margin="20,0,0,0"/></WrapPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Compatible graphics drivers" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="InstalledGpuDrivers" Foreground="#A5B3C7" Margin="0,12,0,12"/><TextBlock Text="Uses Windows Update's hardware-compatible driver selection. The newest vendor driver may differ; no automated third-party driver packs are used." Foreground="#7F8FA3" FontSize="11" Margin="0,0,0,16"/><WrapPanel><Button Content="Scan compatible updates" Style="{StaticResource Primary}" Click="ScanDriversClick" Margin="0,0,10,8"/><Button x:Name="InstallDriversButton" Content="Install detected updates" IsEnabled="False" Click="InstallDriversClick" Margin="0,0,10,8"/><Button Content="Official vendor downloads ↗" Click="VendorWebsiteClick" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="DriverResults" Foreground="#A5B3C7" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Driver cleanup &amp; recovery" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="DDU does not provide a verified unattended interface for this app. Safe Mode, display recovery and cleanup choices remain manual. Create a restore point and export drivers first." Foreground="#8F9CB0" Margin="0,12,0,18"/><WrapPanel><Button Content="Export installed drivers" Click="DriverBackupClick" Margin="0,0,10,8"/><Button Content="Official DDU guide ↗" Click="DduClick" Margin="0,0,10,8"/><Button Content="Device Manager / rollback" Click="DeviceManagerClick" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid x:Name="DebloatPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Remove optional apps. Keep Windows intact." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Auto debloat previews a small reviewed list of optional consumer apps. Store, App Installer, frameworks and core Windows packages stay protected. Package files may be removed; reinstall is not guaranteed from an inventory backup." Foreground="#8F9CB0" FontSize="12" Margin="0,12,0,16"/><WrapPanel><Button Content="Auto debloat" Style="{StaticResource Primary}" Click="AutoDebloatClick" Margin="0,0,10,8"/><Button Content="Installed desktop apps ↗" Click="InstalledAppsClick" Margin="0,0,10,8"/><Button Content="Reinstall from retained files" Click="ReinstallAppClick" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="MicrosoftAppsTab" GroupName="Apps" Content="Microsoft apps" Style="{StaticResource Navigation}" IsChecked="True" Padding="14,8" Click="AppTabClick"/><RadioButton x:Name="OtherAppsTab" GroupName="Apps" Content="Other apps" Style="{StaticResource Navigation}" Padding="14,8" Click="AppTabClick"/></StackPanel><ListBox x:Name="AppList" Grid.Row="2"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/><Button Grid.Column="1" Content="Remove" Tag="{Binding}" Click="RemoveAppClick"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    <ScrollViewer x:Name="NetworkPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Network setup" FontSize="20" FontWeight="SemiBold"/><ComboBox x:Name="Adapters" Margin="0,18,0,12" SelectionChanged="AdapterChanged"/><TextBlock x:Name="AdapterDetails" Foreground="#8F9CB0" Margin="0,0,0,16"/><TextBlock Text="Automatic setup configures Cloudflare IPv4 DNS, flushes its cache and verifies name resolution. It preserves the original static/DHCP DNS mode. It does not guess MTU/TCP values or promise lower game ping." FontSize="12" Foreground="#8F9CB0" Margin="0,0,0,16"/><WrapPanel><Button Content="Auto configure network DNS" Style="{StaticResource Primary}" Click="AutoNetworkClick" Margin="0,0,10,8"/><Button Content="Restore original DNS" Click="RestoreNetworkClick" Margin="0,0,10,8"/><Button Content="Run connection test" Click="NetworkTestClick" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Connection diagnostics" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="NetworkResults" Text="A short ICMP test reports latency, variation and lost replies. A firewall can block ICMP without blocking gaming traffic." Foreground="#8F9CB0" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid x:Name="ServicesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,0,14"><TextBlock Text="Turn a switch on to disable that optional service; turn it off to restore Apex's original. Search, printing, maps, media sharing or Xbox features can stop working. Windows Update, Defender, firewall and driver-installation services are excluded." Foreground="#93A1B4" FontSize="12"/></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ServiceList" ItemTemplate="{StaticResource ToggleRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></Grid>
    <ScrollViewer x:Name="BiosPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Motherboard &amp; BIOS" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BiosDetails" Foreground="#A5B3C7" FontSize="14" Margin="0,18,0,20"/><WrapPanel><Button Content="Export BIOS report" Style="{StaticResource Primary}" Click="ExportBiosClick" Margin="0,0,10,0"/><Button Content="OEM support ↗" Click="OemWebsiteClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="SCEWIN compatibility" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Read-only · no verified OEM write profile" Foreground="#73B4FF" Margin="0,14,0,8"/><TextBlock Text="An AMI BIOS or a detected SCEWIN executable is not enough to establish safe compatibility. Automated writes need an exact motherboard/revision, an OEM-supported tool version, validated setting mappings and recovery support. Apex does not run generic SCEWIN commands or bypass firmware protections." Foreground="#8F9CB0" FontSize="12"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Fill="#4FADFF" Width="4" Height="4" HorizontalAlignment="Left"/><TextBlock x:Name="Status" Grid.Column="1" Text="Ready" Foreground="#7E8A9B" FontSize="10" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="APEX TWEAKS / PREVIEW 0.3" FontSize="9" Foreground="#53657B" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
  </Grid>
 </Grid>
</Window>
